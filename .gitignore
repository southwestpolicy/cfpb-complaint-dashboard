# --- Licensed fonts: MUST NOT be published ---------------------------------
# brand/Minion*.ttf are Adobe Minion Pro, converted from the faces bundled with
# Acrobat. They are commercially licensed and redistributing them in a public
# repository would breach that licence. sppi_brand.py regenerates them locally
# from the Acrobat install, so nothing is lost by excluding them.
brand/*.ttf
brand/*.otf

# --- Generated artwork and analysis output ---------------------------------
# All regenerated by the build scripts; keeping them out avoids a repository
# that grows by megabytes every run.
brand/cover_art.png
brand/fig_*.png
out/
*.pdf

# --- Data stores -----------------------------------------------------------
# The research extract is ~15 GB and the dashboard index ~69 MB; neither
# belongs in git. The index travels on a GitHub Release instead.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.csv.gz
dashboard_index.sqlite*

# Large intermediate CSVs produced by the dedupe passes.
exact_duplicate_groups.csv
near_duplicate_clusters.csv

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and scratch ------------------------------------------------------
*.log
_mapcheck.svg
_map*.png
